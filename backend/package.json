    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "playwright": "^1.49.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
