# --- API ---
PORT=3001
ROOT_DOMAIN=loqta.shop
# Comma-separated Vite dev origins allowed by CORS (production is same-origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
# Server-only. Never in frontend env, never in git, never printed in logs.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret (Project Settings -> API). Projects on the newer
# asymmetric keys can leave this empty - the API falls back to JWKS.
SUPABASE_JWT_SECRET=
# Direct Postgres connection (port 5432, or Supavisor SESSION mode).
# pg-boss does NOT work through the transaction pooler.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# --- AI content generation (Google AI Studio) ---
GEMINI_API_KEY=

# --- Optional: scraping API fallback for sites that block headless browsers ---
SCRAPER_API_KEY=

# --- Optional: AliExpress Dropshipping API (open.aliexpress.com - apply early) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Worker tuning ---
IMPORT_SWEEP_MS=5000
SYNC_BATCH_SIZE=25

# --- WhatsApp via Twilio (optional; features stay off while unset) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender, e.g. +14155238886 for the sandbox ("whatsapp:" prefix added automatically)
TWILIO_WHATSAPP_NUMBER=
# Approved Content SID of the merchant new-order alert template (docs/whatsapp-templates.md)
TWILIO_CONTENT_SID_MERCHANT_ALERT=
# Public API base URL — required for Twilio webhook signature validation behind a proxy
PUBLIC_API_URL=

# --- Merchant email notifications via Resend (optional) ---
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Loqta <notifications@loqta.shop>
