# Direct Postgres connection (Supabase -> Project Settings -> Database -> Connection string, port 5432).
# pg-boss needs a direct (non-transaction-pooler) connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# AI content generation (Google AI Studio)
GEMINI_API_KEY=

# Optional: scraping API fallback for sites that block headless browsers
SCRAPER_API_KEY=

# Optional: AliExpress Dropshipping API (apply at open.aliexpress.com -> approval takes time, apply early)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Sync tuning
SYNC_BATCH_SIZE=25
IMPORT_SWEEP_MS=5000
